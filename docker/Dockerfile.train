FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements/train.txt .
RUN python -m pip install --no-cache-dir --prefix=/install -r train.txt

FROM python:3.11-slim AS training
WORKDIR /app

COPY --from=builder /install /usr/local
COPY src/ ./src/

ENV PYTHONUNBUFFERED=1
ENV TRAINING_CONFIG=/config/training_config.yaml

RUN useradd --create-home --uid 10001 trainer \
	&& mkdir -p /config /app/data /app/checkpoints \
	&& chown -R trainer:trainer /app /config

USER trainer
VOLUME ["/config", "/app/data", "/app/checkpoints"]

ENTRYPOINT ["python", "src/train.py"]